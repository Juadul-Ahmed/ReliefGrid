generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum OrganizationApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum OrganizationDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum TeamType {
  MEDICAL
  RESCUE
  FIRE_RESPONSE
  LOGISTICS
  TRANSPORTATION
  SHELTER_SUPPORT
  COMMUNICATION
  GENERAL_RESPONSE
  OTHER
}

enum TeamStatus {
  FORMING
  ACTIVE
  DEPLOYED
  UNAVAILABLE
  INACTIVE
}

enum TeamMemberRole {
  LEADER
  DEPUTY_LEADER
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum IncidentReportStatus {
  RECEIVED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  DUPLICATE
}

enum IncidentCategory {
  FIRE
  FLOOD
  EARTHQUAKE
  LANDSLIDE
  STORM
  MEDICAL
  ACCIDENT
  MISSING_PERSON
  OTHER
}

enum IncidentReportSource {
  PUBLIC
  USER
  ORGANIZATION
  SYSTEM
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ASSESSING
  ACTIVE
  CONTAINED
  RESOLVED
  CLOSED
  SUSPENDED
  CANCELLED
}

enum IncidentParticipantStatus {
  INVITED
  ACTIVE
  REJECTED
  EXPIRED
  SUSPENDED
  WITHDRAWN
  COMPLETED
}

enum IncidentParticipantRoleType {
  MEDICAL
  LOGISTICS
  RESCUE
  SUPPORT
}

enum IncidentParticipantPermissionType {
  VIEW_INCIDENT
  UPDATE_INCIDENT
  MANAGE_REQUESTS
  VIEW_RESOURCES
  PROPOSE_ALLOCATIONS
  MANAGE_ASSIGNMENTS
  VIEW_REPORTS
}

enum IncidentLeadTransferStatus {
  REQUESTED
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum IncidentUpdateVisibility {
  LEAD_ORGANIZATION
  PARTICIPATING_ORGANIZATIONS
  PUBLIC
}

enum IncidentAssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum IncidentAssignmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentAttachmentVisibility {
  PRIVATE
  PARTICIPANTS
}

// ======================================================
// BETTER AUTH
// Keep Better Auth field names and model mappings intact.
// ======================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  systemRole    String   @default("USER")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  submittedApplications OrganizationApplication[] @relation("ApplicationApplicant")
  reviewedApplications  OrganizationApplication[] @relation("ApplicationReviewer")

  requestedDeletionRequests OrganizationDeletionRequest[] @relation("DeletionRequester")
  reviewedDeletionRequests  OrganizationDeletionRequest[] @relation("DeletionReviewer")

  auditLogs AuditLog[]

  ledTeams         Team[]       @relation("TeamLeader")
  teamMemberships  TeamMember[] @relation("TeamMemberUser")
  addedTeamMembers TeamMember[] @relation("TeamMemberAddedBy")

  submittedIncidentReports IncidentReport[] @relation("IncidentReportSubmitter")
  verifiedIncidentReports  IncidentReport[] @relation("IncidentReportVerifier")

  createdIncidents     Incident[] @relation("IncidentCreator")
  verifiedIncidents    Incident[] @relation("IncidentVerifier")
  coordinatedIncidents Incident[] @relation("IncidentCoordinator")

  grantedIncidentPermissions IncidentParticipantPermission[] @relation("PermissionGrantedBy")

  sentIncidentParticipantInvitations      IncidentParticipant[] @relation("IncidentParticipantInviter")
  respondedIncidentParticipantInvitations IncidentParticipant[] @relation("IncidentParticipantResponder")

  requestedLeadTransfers IncidentLeadTransfer[] @relation("LeadTransferRequester")
  reviewedLeadTransfers  IncidentLeadTransfer[] @relation("LeadTransferReviewer")

  incidentUpdates IncidentUpdate[] @relation("IncidentUpdateAuthor")
  incidentNotes   IncidentNote[]   @relation("IncidentNoteAuthor")

  createdIncidentAssignments  IncidentAssignment[] @relation("AssignmentCreator")
  assignedIncidentAssignments IncidentAssignment[] @relation("AssignmentUser")

  uploadedIncidentAttachments IncidentAttachment[] @relation("AttachmentUploader")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ======================================================
// ORGANIZATION
// ======================================================

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  String?

  status String @default("PENDING")

  members     Member[]
  invitations Invitation[]

  applications        OrganizationApplication[]
  deletionRequests    OrganizationDeletionRequest[]
  approvedApplication OrganizationApplication?      @relation("ApprovedApplication")

  auditLogs AuditLog[]
  teams     Team[]

  ledIncidents           Incident[]            @relation("IncidentLeadOrganization")
  incidentParticipations IncidentParticipant[]

  outgoingLeadTransfers IncidentLeadTransfer[] @relation("TransferFromOrganization")
  incomingLeadTransfers IncidentLeadTransfer[] @relation("TransferToOrganization")

  incidentUpdates IncidentUpdate[]
  incidentNotes   IncidentNote[]

  @@unique([slug])
  @@index([status])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  status         String       @default("ACTIVE")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ======================================================
// ORGANIZATION APPLICATION
// ======================================================

model OrganizationApplication {
  id String @id @default(cuid())

  applicantId String
  applicant   User   @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)

  organizationName String
  requestedSlug    String
  organizationType String
  description      String?
  contactEmail     String
  contactPhone     String?
  address          String?

  status OrganizationApplicationStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt  DateTime?
  reviewNotes String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  approvedOrganizationId String?       @unique
  approvedOrganization   Organization? @relation("ApprovedApplication", fields: [approvedOrganizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
  @@index([status, createdAt])
  @@index([requestedSlug])
  @@map("organization_application")
}

// ======================================================
// ORGANIZATION DELETION REQUEST
// ======================================================

model OrganizationDeletionRequest {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("DeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?   @relation("DeletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  status OrganizationDeletionRequestStatus @default(PENDING)

  reason      String
  reviewNotes String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("organization_deletion_request")
}

// ======================================================
// AUDIT LOG
// ======================================================

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  actorType         AuditActorType @default(USER)
  actorNameSnapshot String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String

  before   Json?
  after    Json?
  metadata Json?

  requestId String?
  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_log")
}

// ======================================================
// TEAM
// ======================================================

model Team {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name        String
  description String?

  teamType TeamType
  status   TeamStatus @default(FORMING)

  leaderId String
  leader   User   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)

  members     TeamMember[]
  assignments IncidentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([leaderId])
  @@map("team")
}

// ======================================================
// TEAM MEMBER
// ======================================================

model TeamMember {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  role   TeamMemberRole   @default(MEMBER)
  status TeamMemberStatus @default(ACTIVE)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  addedById String?
  addedBy   User?   @relation("TeamMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
  @@map("team_member")
}

// ======================================================
// INCIDENT REPORT
// ======================================================

model IncidentReport {
  id String @id @default(cuid())

  title       String
  description String
  category    IncidentCategory
  severity    IncidentSeverity

  source IncidentReportSource @default(PUBLIC)

  submitterId String?
  submitter   User?   @relation("IncidentReportSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)

  locationName String?
  address      String?
  latitude     Float?
  longitude    Float?

  status IncidentReportStatus @default(RECEIVED)

  verifiedById String?
  verifiedBy   User?   @relation("IncidentReportVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  verifiedAt      DateTime?
  rejectionReason String?

  duplicateOfReportId String?
  duplicateOfReport   IncidentReport?  @relation("DuplicateIncidentReports", fields: [duplicateOfReportId], references: [id], onDelete: SetNull)
  duplicateReports    IncidentReport[] @relation("DuplicateIncidentReports")

  incidentId String?
  incident   Incident? @relation("IncidentReports", fields: [incidentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, severity])
  @@index([submitterId])
  @@index([verifiedById])
  @@index([incidentId])
  @@index([duplicateOfReportId])
  @@map("incident_report")
}

// ======================================================
// INCIDENT
// ======================================================

model Incident {
  id String @id @default(cuid())

  incidentNumber String @unique
  title          String
  description    String

  category IncidentCategory
  severity IncidentSeverity
  status   IncidentStatus   @default(OPEN)

  leadOrganizationId String
  leadOrganization   Organization @relation("IncidentLeadOrganization", fields: [leadOrganizationId], references: [id], onDelete: Restrict)

  locationName String?
  address      String?
  latitude     Float?
  longitude    Float?
  occurredAt   DateTime?

  createdById String?
  createdBy   User?   @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  coordinatorId String?
  coordinator   User?   @relation("IncidentCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  verifiedById String?
  verifiedBy   User?   @relation("IncidentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  verifiedAt DateTime?

  reports       IncidentReport[]       @relation("IncidentReports")
  participants  IncidentParticipant[]
  leadTransfers IncidentLeadTransfer[]
  updates       IncidentUpdate[]
  notes         IncidentNote[]
  assignments   IncidentAssignment[]
  attachments   IncidentAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([category])
  @@index([leadOrganizationId, status])
  @@index([createdById])
  @@index([coordinatorId])
  @@index([verifiedById])
  @@index([occurredAt])
  @@map("incident")
}

// ======================================================
// INCIDENT PARTICIPANT
// ======================================================

model IncidentParticipant {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  status IncidentParticipantStatus @default(INVITED)

  // Invitation history
  invitedById String?
  invitedBy   User?   @relation("IncidentParticipantInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  respondedById String?
  respondedBy   User?   @relation("IncidentParticipantResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  respondedAt DateTime?
  expiresAt   DateTime?

  roles       IncidentParticipantRole[]
  permissions IncidentParticipantPermission[]

  joinedAt    DateTime?
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([incidentId, organizationId])
  @@index([organizationId, status])
  @@index([incidentId, status])
  @@index([invitedById])
  @@index([respondedById])
  @@index([status, expiresAt])
  @@map("incident_participant")
}

// ======================================================
// INCIDENT PARTICIPANT ROLE
// ======================================================

model IncidentParticipantRole {
  id String @id @default(cuid())

  participantId String
  participant   IncidentParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  role IncidentParticipantRoleType

  createdAt DateTime @default(now())

  @@unique([participantId, role])
  @@index([role])
  @@map("incident_participant_role")
}

// ======================================================
// INCIDENT PARTICIPANT PERMISSION
// ======================================================

model IncidentParticipantPermission {
  id String @id @default(cuid())

  participantId String
  participant   IncidentParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  permission IncidentParticipantPermissionType

  grantedById String?
  grantedBy   User?   @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([participantId, permission])
  @@index([grantedById])
  @@map("incident_participant_permission")
}

// ======================================================
// INCIDENT LEAD TRANSFER
// ======================================================

model IncidentLeadTransfer {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  fromOrganizationId String
  fromOrganization   Organization @relation("TransferFromOrganization", fields: [fromOrganizationId], references: [id], onDelete: Restrict)

  toOrganizationId String
  toOrganization   Organization @relation("TransferToOrganization", fields: [toOrganizationId], references: [id], onDelete: Restrict)

  status IncidentLeadTransferStatus @default(REQUESTED)

  requestedById String
  requestedBy   User   @relation("LeadTransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?   @relation("LeadTransferReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reason      String?
  reviewNotes String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, status])
  @@index([fromOrganizationId])
  @@index([toOrganizationId])
  @@index([requestedById])
  @@map("incident_lead_transfer")
}

// ======================================================
// INCIDENT UPDATE
// ======================================================

model IncidentUpdate {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  authorId String
  author   User   @relation("IncidentUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  title   String?
  content String

  visibility IncidentUpdateVisibility @default(LEAD_ORGANIZATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
  @@index([visibility])
  @@map("incident_update")
}

// ======================================================
// INCIDENT NOTE
// ======================================================

model IncidentNote {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  authorId String
  author   User   @relation("IncidentNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
  @@map("incident_note")
}

// ======================================================
// INCIDENT ASSIGNMENT
// ======================================================

model IncidentAssignment {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  // Exactly one target is required.
  // PostgreSQL CHECK constraint will enforce this.

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  assigneeUserId String?
  assigneeUser   User?   @relation("AssignmentUser", fields: [assigneeUserId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  title       String
  description String?

  status   IncidentAssignmentStatus   @default(PENDING)
  priority IncidentAssignmentPriority @default(NORMAL)

  dueAt       DateTime?
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, status])
  @@index([teamId, status])
  @@index([assigneeUserId, status])
  @@index([createdById])
  @@map("incident_assignment")
}

// ======================================================
// INCIDENT ATTACHMENT
// ======================================================

model IncidentAttachment {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  fileName   String
  storageKey String @unique
  mimeType   String
  fileSize   BigInt

  visibility IncidentAttachmentVisibility @default(PRIVATE)

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([uploadedById])
  @@index([visibility])
  @@map("incident_attachment")
}
